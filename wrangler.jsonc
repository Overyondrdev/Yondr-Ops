{
  "$schema": "node_modules/wrangler/config-schema.json",
  // yondr-ops: monitoring, alerts, backups and the auto-fix log for the overyondrdev.com estate (README.md).
  "name": "yondr-ops",
  "account_id": "3fac6c19097c5692e17198cffa818085",
  "main": "src/index.js",
  "compatibility_date": "2026-11-20",
  // Bundles public/ into src/static.generated.js before every `wrangler dev` / `wrangler deploy`.
  // No Workers static assets: `wrangler deploy` from Claude cloud sessions can't upload them (README "Deploy").
  "build": { "command": "node scripts/build-static.mjs", "watch_dir": "public" },
  "observability": { "enabled": true },
  "triggers": {
    // Every 5 minutes: monitoring incl. server errors (src/monitor.js). Every 5 minutes, 2 minutes later: auto-fix queue,
    // watch and verification, and the deploy watch (src/verify.js, src/deploys.js; AUTOFIX_CRON in src/index.js).
    // 03:17 UTC: backups, then the daily jobs: restore drill on the 1st, key expiry, quarterly access review, retention
    // (src/daily.js; BACKUP_CRON). Keep it at 3 crons (Workers Free: 5 per account).
    "crons": ["*/5 * * * *", "2-59/5 * * * *", "17 3 * * *"]
  },
  "d1_databases": [
    // Ops' own data (created 27 Nov 2026).
    { "binding": "DB", "database_name": "yondr-ops", "database_id": "c724f62c-94f2-4fce-b69c-f953ff0ee37d" },
    // Other tools' databases: READ ONLY by code (src/readonly.js). FEEDBACK_DB also holds the one admin list.
    { "binding": "FEEDBACK_DB", "database_name": "yondr-feedback", "database_id": "d1284d94-c7e8-4b9e-9526-b108c8425d87" },
    { "binding": "ADS_DB", "database_name": "yondr-ad-portal-db", "database_id": "dfdcc2cc-4505-4ff7-944a-1fcd52abb04d" },
    { "binding": "REQUESTS_DB", "database_name": "yondr-marketing-requests-db", "database_id": "78cc06d7-c778-47eb-b630-6b9b0da5c43c" },
    // Client names and postal addresses (personal data): shorter backup retention, owners-only backup download.
    { "binding": "CARDS_DB", "database_name": "yondr-christmas-cards", "database_id": "85da3dd4-e124-4087-a369-d48647053be3" },
    // Scratch database for the monthly restore drill (src/drill.js). The ONLY database ops ever drops tables in; it
    // holds nothing of value (personal data is dropped again straight after each drill).
    { "binding": "DRILL_DB", "database_name": "yondr-ops-restore-drill", "database_id": "456502b9-794b-4e3f-8263-b0f11f6868d4" }
  ],
  // The feedback tool's Worker, for People & permissions: role changes go through ITS admin API with the signed-in
  // person's own session (src/people.js). A service binding: no public egress, no same-zone fetch loop.
  "services": [
    { "binding": "FEEDBACK", "service": "yondr-feedback" }
  ],
  // The people directory of the sign-in Worker yondr-auth (KV `yondr-directory`): ops reads the sync status
  // (directory:meta) and names for the digest. READ ONLY by code (src/directory.js; scripts/check.mjs enforces it).
  "kv_namespaces": [
    { "binding": "DIRECTORY", "id": "5339d6576e0f40ca83134966a8d50536" }
  ],
  "r2_buckets": [
    // Nightly backups (create it first: README "First deploy").
    { "binding": "BACKUPS", "bucket_name": "yondr-ops-backups" }
  ],
  // Workers AI: classifies bug reports as objective or subjective for the auto-fix engine (src/classify.js).
  "ai": { "binding": "AI" },
  "vars": {
    // Yondr Google sign-in (auth.overyondrdev.com): public key of the shared session cookie. Safe to commit.
    "YONDR_AUTH_PUBLIC_JWK": "{\"kty\":\"EC\",\"crv\":\"P-256\",\"x\":\"BpCjLJMykOsJbtPTm63rdbw2BzRUTNTz3jj9LWqK6AM\",\"y\":\"RyW0y7Dki1BQ6GnYdD-4FPovGYfoaMmDgr21lNU7xXQ\",\"kid\":\"yondr-2026-11-26-a3a7e6\"}",
    "ALLOWED_EMAIL_DOMAINS": "overyondr.com",
    "EMAIL_FROM": "alerts@overyondrdev.com",
    "EMAIL_FROM_NAME": "Yondr Ops",
    // cloudflare | resend | off (the owner can override it in Settings).
    "EMAIL_TRANSPORT": "resend"
    // Secrets (npx wrangler secret put NAME; README "Secrets"): CF_API_TOKEN, CF_DEPLOY_TOKEN (rollback only),
    // GITHUB_TOKEN, OPS_INGEST_TOKEN, RESEND_API_KEY (only for the resend transport), SLACK_WEBHOOK_<NAME> (one per
    // Slack channel).
  },
  // Platform rule: no public *.workers.dev or preview URLs; the tool lives only on its custom domain.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "ops.overyondrdev.com", "custom_domain": true }
  ]
}
